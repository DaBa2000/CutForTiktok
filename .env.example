# Copy to .env and fill in. .env is gitignored.

# --- Twitch (https://dev.twitch.tv/console -> Register Your Application) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- TikTok (https://developers.tiktok.com -> Manage apps -> add "Login Kit" + "Content Posting API") ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match a redirect URI registered in your TikTok app
TIKTOK_REDIRECT_URI=http://localhost:8765/callback
# inbox  = upload as draft, you finish posting in the TikTok app (no audit needed)
# direct = publish directly (needs audited app; unaudited apps can only post SELF_ONLY)
TIKTOK_POST_MODE=inbox
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
TIKTOK_PRIVACY=SELF_ONLY

# --- Optional overrides ---
# WHISPER_MODEL=large-v3-turbo
# DATA_DIR=data
