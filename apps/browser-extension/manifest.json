{
  "manifest_version": 3,
  "name": "TikTok Clip Poster",
  "version": "1.1.0",
  "description": "Fills exported CutForTiktok clips (video + description) into the TikTok upload page, posts them now or at a planned time, and marks them as posted.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://www.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TikTok Clip Poster",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  }
}